<?xml version="1.0" encoding="utf-8"?><!-- Debug HTTP is limited to explicit developer endpoints; never ship as release.
     Add a specific LAN host here for physical-device Docker testing; no subnet wildcard.
     The Kotlin ApiEndpointPolicy separately restricts debug HTTP to private targets. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!--- <domain includeSubdomains="IPV4">192.168.110.77</domain> S21Fe -->
        <domain includeSubdomains="IPV4">192.168.18.5</domain>
        <domain includeSubdomains="LOCALHOST">localhost</domain>
    </domain-config>
</network-security-config>
